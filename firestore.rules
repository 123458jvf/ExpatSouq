// Firestore Security Rules — ExpatSouq
//
// Deploy with: firebase deploy --only firestore:rules
//
// Admin UID: 3iAZVHBrmIcxBdPwb9mfABqut3H2
// (hardcoded — the account with this UID is the only admin)

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'ERVJZLM06fQzytjCTpoPh7X0SCx1';
    }

    match /ads/{adId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.city is string
        && request.resource.data.desc is string
        && request.resource.data.description is string
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'price', 'city', 'area', 'desc', 'updatedAt', 'status'
          ])
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /jobs/{jobId} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create, update, delete: if isAdmin();
    }

    match /siteConfig/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /postViewCounts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['views'])
        && request.resource.data.views is int
        && request.resource.data.views == 1;
      allow update: if request.resource.data.keys().hasOnly(['views'])
        && resource.data.views is int
        && request.resource.data.views is int
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if false;
    }

    match /siteAnalytics/{documentId} {
      allow read: if isAdmin();
      allow create: if documentId == 'summary'
        && request.resource.data.keys().hasOnly(['totalVisits', 'uniqueVisitors'])
        && request.resource.data.totalVisits is int
        && request.resource.data.totalVisits == 1
        && request.resource.data.uniqueVisitors is int
        && request.resource.data.uniqueVisitors in [0, 1];
      allow update: if documentId == 'summary'
        && request.resource.data.keys().hasOnly(['totalVisits', 'uniqueVisitors'])
        && resource.data.totalVisits is int
        && resource.data.uniqueVisitors is int
        && request.resource.data.totalVisits is int
        && request.resource.data.uniqueVisitors is int
        && request.resource.data.totalVisits == resource.data.totalVisits + 1
        && (request.resource.data.uniqueVisitors == resource.data.uniqueVisitors
          || request.resource.data.uniqueVisitors == resource.data.uniqueVisitors + 1);
      allow delete: if false;
    }
  }
}